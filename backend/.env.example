# Copy this file to a new file named ".env" (same folder) and fill in real values.
# NEVER commit the real .env file to GitHub.

# Port for local development. On Render the platform sets PORT automatically.
PORT=5000

# MongoDB Atlas connection string (see README section F).
# Remember to replace <password> and add the database name "taskflow" before the "?".
mongodb+srv://<db_username>:<db_password>@taskmanager.ne2sbm5.mongodb.net/

# A long random string used to sign login tokens (see README section G to generate one).
JWT_SECRET=d38d43793fdf84b4725abde94fd7f81a70b4d7a6b28136a3bb1d07d3e35b1184

# How long a login lasts (optional, default is 7d).
JWT_EXPIRES_IN=7d

# The URL of the frontend that is allowed to call this API.
# Local: http://localhost:5173   Production: your Vercel URL (no trailing slash).
# You can list several URLs separated by commas.
CLIENT_URL=http://localhost:5173

# "development" locally, "production" on Render.
NODE_ENV=development
