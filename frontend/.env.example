# Copy this file to ".env" inside the frontend folder.
# IMPORTANT: every VITE_ variable is bundled into the public website and visible to anyone.
# Never put secrets (database passwords, JWT secrets) in a frontend env file.

# URL of the backend API, including the /api part, with no trailing slash.
# Local development:
VITE_API_URL=http://localhost:5000/api
# After deploying, set this (in Vercel) to your Render URL, e.g.
# VITE_API_URL=https://your-backend-name.onrender.com/api
